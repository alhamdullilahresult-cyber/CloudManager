# Environment Variables — Boyfinity Script Manager
# Copy this to your Vercel Project Settings → Environment Variables

# ─── SUPABASE ─────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXX

# ─── AUTH ─────────────────────────────────────────────────────
# JWT secret: use a long random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-here-change-this

# Admin password (plaintext, server-side only - NEVER exposed to frontend)
# Set this in Vercel Dashboard → Settings → Environment Variables
ADMIN_PASSWORD=your_admin_password_here

