# Environment Variables — Boyfinity Script Manager
# Copy this to your Vercel Project Settings → Environment Variables

# ─── SUPABASE ─────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXX

# ─── AUTH ─────────────────────────────────────────────────────
# JWT secret: use a long random string (min 32 chars)
# Generate: openssl rand -hex 32
JWT_SECRET=your-very-long-random-secret-here-change-this

# Admin password options (use ONE of these):

# Option A (Recommended): bcrypt hash of your admin password
# Generate hash: node -e "const b=require('bcryptjs');b.hash('your_password',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Option B (Less secure, for initial setup only - remove after adding hash):
# ADMIN_PASSWORD=your_plain_password_here

