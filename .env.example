# Environment Variables — BOYFINITY Script Platform
# Configure these in your Vercel Project Settings → Environment Variables

# ─── SUPABASE ─────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXX

# ─── JWT & SECURITY ───────────────────────────────────────────
JWT_SECRET=your-very-long-random-secret-here-minimum-32-chars
ADMIN_PASSWORD=your_master_owner_password_here

# ─── DISCORD OAUTH2 (AUTHENTICATION) ──────────────────────────
# Create Application at: https://discord.com/developers/applications
# Redirect URL: https://<your-domain>.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://boyfinity-script.vercel.app/api/auth/discord/callback

# Owner Discord IDs (comma-separated, auto-grants Owner role)
DISCORD_OWNER_IDS=your_discord_id_here

# ─── DISCORD WEBHOOK FOR KEY DELIVERY ─────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxx/xxxxxxxxxxxx

# ─── CLOUDFLARE TURNSTILE (CAPTCHA / HUMAN VERIFICATION) ──────
# Create Site at: https://dash.cloudflare.com/ -> Turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAXXXXXXXXXXXXXX
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAXXXXXXXXXXXXXX
