# Environment Variables — BOYFINITY Script Platform
# Configure these in your Vercel Project Settings → Environment Variables

# ─── SUPABASE ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── JWT & SECURITY ───────────────────────────────────────────
JWT_SECRET=your-random-jwt-secret-string
ADMIN_PASSWORD=your-fallback-master-password

# ─── DISCORD OAUTH2 (AUTHENTICATION) ──────────────────────────
# Create Application at: https://discord.com/developers/applications
# Redirect URL: https://<your-domain>.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://boyfinity-script.vercel.app/api/auth/discord/callback

# Owner Discord IDs (comma-separated, auto-grants Owner role)
DISCORD_OWNER_IDS=your-discord-user-id

# ─── DISCORD WEBHOOK FOR KEY DELIVERY ─────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# ─── CLOUDFLARE TURNSTILE (CAPTCHA / HUMAN VERIFICATION) ──────
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-sitekey-here
CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-sitekey-here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
