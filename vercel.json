{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/admin/scripts/:id", "destination": "/api/admin/scripts/[id]" },
    { "source": "/api/admin/scripts", "destination": "/api/admin/scripts" },
    { "source": "/api/scripts/:id", "destination": "/api/scripts/[id]" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/raw", "destination": "/api/raw" }
  ]
}
