{
  "version": 2,
  "builds": [
    {
      "src": "api/raw.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/script.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/raw",
      "dest": "/api/raw.js"
    },
    {
      "src": "/api/script",
      "dest": "/api/script.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

