{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login.js"
    },
    {
      "src": "/api/auth/verify",
      "dest": "/api/auth/verify.js"
    },
    {
      "src": "/api/admin/stats",
      "dest": "/api/admin/stats.js"
    },
    {
      "src": "/api/admin/scripts/(?<id>[^/]+)",
      "dest": "/api/admin/scripts/[id].js"
    },
    {
      "src": "/api/admin/scripts",
      "dest": "/api/admin/scripts/index.js"
    },
    {
      "src": "/api/scripts/(?<id>[^/]+)",
      "dest": "/api/scripts/[id].js"
    },
    {
      "src": "/raw",
      "dest": "/api/raw.js"
    },
    {
      "src": "/api/script",
      "dest": "/api/script.js"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
