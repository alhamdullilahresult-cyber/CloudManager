{
  "version": 2,
  "rewrites": [
    {
      "source": "/raw",
      "destination": "/api/raw"
    },
    {
      "source": "/api/admin/scripts/:id",
      "destination": "/api/admin/scripts/[id]"
    },
    {
      "source": "/api/scripts/:id",
      "destination": "/api/scripts/[id]"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}
